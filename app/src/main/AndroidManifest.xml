<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- screenOrientation="portrait" implies a required portrait screen, which Play reads as
         "not for tablets/desktops"; the app works on any screen, so make it optional. -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="Rezina"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <!-- Portrait is locked: tilting the phone is an input, it must not rotate the screen. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
